{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kingdomsx-web",
  "account_id": "97b60c4ab41073fb11d7cb63e7bfa3c7",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "kingdomsx.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kingdomsx.com",
      "custom_domain": true
    },
    {
      "pattern": "assets.kingdomsx.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/build/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
