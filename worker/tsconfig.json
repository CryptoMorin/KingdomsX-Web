{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": [
    "bindings.production.d.ts",
    "index.ts",
    "server-directory/**/*.ts"
  ]
}
