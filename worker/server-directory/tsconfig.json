{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": [
    "bindings.production.d.ts",
    "worker.ts",
    "index.ts",
    "config.ts",
    "contracts.ts",
    "auth/**/*.ts",
    "core/**/*.ts",
    "discord/**/*.ts",
    "moderation/**/*.ts",
    "public-directory/**/*.ts",
    "status/**/*.ts",
    "submissions/**/*.ts",
    "verification/**/*.ts"
  ]
}
