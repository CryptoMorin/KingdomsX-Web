---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionOrnament from "../components/SectionOrnament.astro";
import { SITE } from "../config";
import logo from "../assets/images/logo.webp";
import editorFontLicenseUrl from "../assets/fonts/minecraft-ui/OFL.txt?url";
import rendererLicenseUrl from "../assets/vendor/block-model-renderer/LICENSE.txt?url&no-inline";
import remoteSessionBootstrapUrl from "../assets/scripts/config-editor/remote-session-bootstrap.js?url&no-inline";
import { REMOTE_EDITOR_SESSION_STORAGE_KEY } from "../assets/scripts/config-editor/remote-editor-link.js";
import "../assets/styles/config-editor.css";

const canonicalUrl = SITE.editor || (SITE.url ? `${SITE.url}/editor` : "/editor");
const homeUrl = SITE.url ? `${SITE.url}/` : "/";
const pageDescription = "Easily change your KingdomsX settings without editing YAML by hand.";
const allowManualWorkspaces = import.meta.env.DEV || process.env.EDITOR_MANUAL_WORKSPACES === "true";
---
<BaseLayout
  title="Config Editor | KingdomsX"
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  robots="noindex, nofollow"
  preloadHeroImage={false}
  includeStructuredData={false}
  includeSiteScript={false}
  includeEditorFont={true}
  editorFontLicenseUrl={editorFontLicenseUrl}
  publicAssetsSameOrigin={true}
>
  <Fragment slot="head">
    <link rel="license" href={rendererLicenseUrl} type="text/plain" title="Block Model Renderer" />
    <meta name="kingdomsx-editor-session-storage-key" content={REMOTE_EDITOR_SESSION_STORAGE_KEY} />
    <script is:inline src={remoteSessionBootstrapUrl}></script>
  </Fragment>

  {allowManualWorkspaces && <input class="visually-hidden" type="file" accept=".zip,.yml,.yaml,application/zip,text/yaml,application/yaml" multiple data-file-input />}
  <input class="visually-hidden" type="file" accept=".schematic,.schem,application/octet-stream" data-schematic-file-input />

  <div class="editor-session-loading page position-relative min-vh-100 d-grid place-items-center px-3 py-5" data-editor-session-loading hidden>
    <div class="editor-save-progress surface-panel rounded-3 p-4 p-md-5 text-center" role="status" aria-live="polite" aria-labelledby="editor-session-loading-title">
      <span class="editor-save-spinner d-inline-grid mb-3" aria-hidden="true"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
      <span class="editor-eyebrow d-block">Secure editor session</span>
      <h1 class="h4 mb-2 mt-1" id="editor-session-loading-title">Opening server configs…</h1>
      <p class="mb-0">Downloading and decrypting your KingdomsX configuration files.</p>
    </div>
  </div>

  <div class="page position-relative min-vh-100 d-flex flex-column" data-editor-empty>
    <Header homeUrl={homeUrl} />
    <main class="flex-grow-1">
      <section class="editor-empty servers servers-page position-relative" aria-labelledby="editor-title">
        <div class="container position-relative z-1">
          <div class="servers-page-head text-center mx-auto">
            <h1 class="section-title mb-0" id="editor-title">KingdomsX Config Editor</h1>
            <SectionOrnament />
            <p class="section-kicker mx-auto">{pageDescription}</p>
          </div>

          <div class={allowManualWorkspaces ? "editor-empty-panels has-manual-workspaces d-grid gap-3" : "editor-empty-panels d-grid gap-3"}>
            <div class="editor-empty-session surface-panel surface-lift rounded-3 p-4 p-md-5 text-center mx-auto d-flex flex-column align-items-center justify-content-center w-100 min-w-0">
              <span class="editor-empty-file-icon d-inline-grid" aria-hidden="true">
                <i class="fa-solid fa-terminal"></i>
              </span>
              <h2 class="mt-3 mb-2">Start from your Minecraft server</h2>
              <p class="editor-empty-lead mx-auto mb-0">Run the editor admin command in-game. The plugin will give you a private link that opens your server's config files here.</p>

              <div class="editor-session-actions d-flex flex-column flex-sm-row align-items-stretch justify-content-center gap-2 gap-sm-3 w-100 mt-4">
                <button class="btn btn-site copy-action editor-session-command d-inline-flex align-items-center justify-content-center gap-2 fw-bold mb-0 position-relative overflow-hidden w-auto" type="button" data-copy-command="/k admin editor" data-copy-success-label="Copied command!" aria-label="Copy in-game command /k admin editor">
                  <code class="cmd position-relative z-1 text-nowrap">/k admin editor</code>
                  <i class="copy-action-icon fa-regular fa-copy flex-shrink-0 position-relative z-1" aria-hidden="true"></i>
                  <span class="visually-hidden" data-copy-status aria-live="polite"></span>
                </button>
                <button class="btn btn-site editor-session-demo d-inline-flex align-items-center justify-content-center gap-2 fw-bold w-auto" type="button" data-example>
                  <i class="fa-solid fa-flask" aria-hidden="true"></i>
                  Try the demo
                </button>
              </div>
            </div>

            {allowManualWorkspaces && (
              <aside class="editor-empty-drop-zone surface-panel surface-lift rounded-3 p-4 p-md-5 text-center mx-auto d-flex flex-column align-items-center justify-content-center w-100 min-w-0" data-drop-zone aria-labelledby="editor-local-testing-title">
                <span class="editor-empty-file-icon d-inline-grid" aria-hidden="true">
                  <i class="fa-solid fa-file-circle-plus fa-2xs"></i>
                </span>
                <span class="editor-eyebrow">Local editing</span>
                <h2 class="mt-2 mb-2" id="editor-local-testing-title">Open files locally</h2>
                <p class="editor-empty-lead mx-auto mb-0">Upload a ZIP containing Kingdoms configs or one or more YAML files to exercise the editor without a plugin session.</p>
                <button class="btn btn-site btn-site-primary d-inline-flex align-items-center justify-content-center gap-2 fw-bold mt-4" type="button" data-open-file>
                  <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                  Open configs or ZIP
                </button>
                <!--<small class="d-block mx-auto mt-3 text-secondary-emphasis">Local test files stay in browser memory and are never uploaded or persisted.</small>-->
              </aside>
            )}
          </div>

          <small class="editor-data-safety d-block w-100 mx-auto mt-3 px-2 text-center text-secondary-emphasis">Your config files stay private and secure. They're encrypted before leaving your server and are only accessible through your unique private link, which works for one hour. <strong>Only share your private link with people you trust, as anyone with the link can edit your KingdomsX config files.</strong> After the time has passed, the editor session is automagically destroyed.</small>
        </div>
      </section>
    </main>
    <Footer />
  </div>

  <main class="config-editor page min-vh-100 d-flex flex-column overflow-hidden" data-editor-shell hidden>
    <header class="site-header editor-header position-relative flex-shrink-0 user-select-none">
      <nav class="navbar py-1 py-sm-2" aria-label="Config editor navigation">
        <div class="editor-header-layout container-fluid">
          <a class="navbar-brand brand d-inline-flex align-items-center gap-3 mb-0 fw-bold" href={canonicalUrl} aria-label="KingdomsX Config Editor home">
            <img class="object-fit-contain" src={logo.src} width="40" height="40" alt="" draggable="false" />
            <span class="editor-brand-copy d-flex flex-column justify-content-center">
              <span class="fw-bold">KingdomsX</span>
              <span class="editor-brand-context">Config Editor</span>
            </span>
          </a>

          <div class="d-flex align-items-center ms-0 ms-lg-3" data-editor-header-controls>
            <div class="d-flex align-items-center justify-content-between gap-3" data-editor-controls>
              <div class="editor-segmented-switch editor-mode-switch position-relative" data-editor-mode-switch data-editor-mode-current="visual" data-loaded-action role="group" aria-label="Editor mode" hidden>
                <span class="editor-segmented-switch-thumb position-absolute" aria-hidden="true"></span>
                <button class="editor-segmented-switch-button editor-mode-switch-button is-active position-relative d-inline-flex align-items-center justify-content-center gap-2" type="button" data-editor-mode="visual" aria-pressed="true" aria-label="Visual">
                  <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                  <span>Visual</span>
                </button>
                <button class="editor-segmented-switch-button editor-mode-switch-button position-relative d-inline-flex align-items-center justify-content-center gap-2" type="button" data-editor-mode="source" aria-pressed="false" aria-label="Code">
                  <i class="fa-solid fa-code" aria-hidden="true"></i>
                  <span>Code</span>
                </button>
              </div>

              <button class="editor-header-action-button editor-header-icon-button btn btn-site-secondary btn-site-sm d-inline-flex align-items-center justify-content-center gap-2 ms-auto" type="button" aria-label="Editor settings" aria-haspopup="dialog" data-open-editor-settings data-loaded-action hidden>
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                <span class="d-none d-xl-inline">Settings</span>
              </button>
            </div>
          </div>

          <div class="editor-header-navigation-actions d-flex align-items-center gap-2 ms-0 ms-lg-3" data-editor-header-navigation hidden>
            <span class="editor-control-hint small text-nowrap d-lg-none" data-editor-session-time hidden></span>
            <button
              class="navbar-toggler d-inline-grid"
              type="button"
              aria-controls="editor-navigation"
              aria-expanded="true"
              title="Hide editor navigation"
              data-toggle-editor-navigation
              data-loaded-action
              hidden
            >
              <span class="navbar-toggler-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Toggle editor navigation</span>
            </button>
          </div>

          <div class="editor-header-actions ms-auto d-flex align-items-center justify-content-end gap-1 gap-sm-2 gap-lg-3" data-loaded-action hidden>
            <span class="editor-change-status d-none d-lg-inline" data-change-status>No changes yet</span>
            <span class="editor-control-hint text-nowrap d-none d-lg-inline" data-editor-session-time hidden></span>
            <button class="editor-header-action-button btn btn-site-secondary btn-site-sm d-inline-flex align-items-center justify-content-center gap-2 px-2 px-sm-3" type="button" data-preview-yaml aria-label="Review changes">
              <i class="fa-regular fa-file-code"></i>
              <span>Review<span class="d-none d-sm-inline"> changes</span></span>
            </button>
            <div class="dropdown flex-shrink-0" data-editor-save-actions>
              <button class="editor-header-action-button btn btn-site btn-site-primary btn-site-sm d-inline-flex align-items-center justify-content-center gap-2 fw-bold w-auto flex-shrink-0 text-nowrap px-1 px-sm-3" type="button" data-save-workspace data-editor-primary-action aria-label="Download file">
                <i class="fa-solid fa-download" aria-hidden="true"></i>
                <span data-download-label>Download file</span>
              </button>
              <button class="editor-header-action-button btn btn-site btn-site-primary btn-site-sm dropdown-toggle dropdown-toggle-split d-inline-flex align-items-center justify-content-center w-auto flex-shrink-0" type="button" data-editor-save-menu-toggle data-bs-toggle="dropdown" aria-label="Backup options" aria-expanded="false" hidden></button>
              <div class="dropdown-menu dropdown-menu-end editor-more-actions-menu">
                <button class="dropdown-item editor-more-actions-item d-grid w-100 border-0 text-start" type="button" data-download-recovery>
                  <span class="editor-more-actions-icon d-grid" aria-hidden="true"><i class="fa-solid fa-download"></i></span>
                  <span class="editor-more-actions-copy d-grid">
                    <span class="editor-more-actions-title fw-bold">Download unsaved work</span>
                    <span class="editor-control-hint">Downloads a backup without saving to the server.</span>
                  </span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <section class="editor-workspace d-grid flex-grow-1 min-h-0" data-editor-workspace hidden>
      <div class="editor-navigation" id="editor-navigation" aria-labelledby="editor-navigation-title" data-editor-navigation>
        <div class="navigation-drawer-header editor-navigation-header align-items-center justify-content-between gap-3">
          <h2 class="navigation-drawer-title offcanvas-title brand d-inline-flex align-items-center gap-3 mb-0 fw-bold" id="editor-navigation-title">
            <img class="object-fit-contain" src={logo.src} width="40" height="40" alt="" draggable="false" />
            <span class="editor-brand-copy d-flex flex-column justify-content-center">
              <span class="fw-bold">KingdomsX</span>
              <span class="editor-brand-context">Config Editor</span>
            </span>
          </h2>
          <button class="navigation-close btn-close d-grid" type="button" aria-label="Close editor navigation" data-close-editor-navigation></button>
        </div>

        <div class="editor-navigation-tabs editor-segmented-switch position-relative mx-3 mt-3" role="tablist" aria-label="Editor navigation" data-editor-navigation-tabs data-editor-navigation-panel="sections" hidden>
          <span class="editor-segmented-switch-thumb position-absolute" aria-hidden="true"></span>
          <button
            class="editor-navigation-tab editor-segmented-switch-button position-relative d-inline-flex align-items-center justify-content-center gap-2"
            id="editor-navigation-files-tab"
            type="button"
            role="tab"
            aria-controls="editor-files-sidebar"
            aria-selected="false"
            tabindex="-1"
            data-editor-navigation-tab="files"
          >
            <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
            Files
          </button>
          <button
            class="editor-navigation-tab editor-segmented-switch-button is-active position-relative d-inline-flex align-items-center justify-content-center gap-2"
            id="editor-navigation-sections-tab"
            type="button"
            role="tab"
            aria-controls="editor-sections-sidebar"
            aria-selected="true"
            data-editor-navigation-tab="sections"
          >
            <i class="fa-solid fa-list" aria-hidden="true"></i>
            Sections
          </button>
        </div>

        <div class="editor-navigation-body">
          <aside class="editor-files-rail d-flex flex-column min-w-0 min-h-0 p-3" id="editor-files-sidebar" data-workspace-files-panel hidden>
            <div class="editor-file-card surface-panel rounded-3 p-3 mb-3 flex-shrink-0">
              <div class="d-flex align-items-start gap-3">
                <span class="editor-file-card-icon place-items-center d-grid flex-shrink-0"><i class="fa-solid fa-file-zipper"></i></span>
                <div class="min-w-0 flex-grow-1">
                  <strong class="editor-item-title d-block text-truncate fw-semibold" data-workspace-name>configs.zip</strong>
                  <span class="editor-file-card-meta d-block mt-1" data-workspace-meta></span>
                </div>
                {allowManualWorkspaces && <button class="editor-icon-button editor-interactive-surface d-inline-grid flex-shrink-0" type="button" title="Open another ZIP or files" aria-label="Open another ZIP or files" data-open-file><i class="fa-solid fa-arrow-right-arrow-left"></i></button>}
              </div>
            </div>
            <div class="editor-eyebrow d-flex align-items-center justify-content-between gap-2 px-1 mb-2">
              <span>Files</span>
              <span class="editor-file-browser-count" data-workspace-files-count></span>
            </div>
            <label class="editor-file-search d-flex align-items-center gap-2 mb-2 rounded-3">
              <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              <span class="visually-hidden">Search config files</span>
              <input class="editor-compact-search w-100 min-w-0 p-0 border-0 bg-transparent" type="search" autocomplete="off" placeholder="Find a file" data-workspace-file-search />
            </label>
            <nav class="editor-file-list flex-grow-1 min-h-0 overflow-auto" data-workspace-files aria-label="Config files"></nav>
          </aside>
          <div
            class="editor-sidebar-resizer position-relative d-none d-lg-block"
            role="separator"
            tabindex="0"
            aria-label="Resize files sidebar"
            aria-controls="editor-files-sidebar"
            aria-orientation="vertical"
            data-sidebar-resizer="files"
            hidden
          ></div>

          <aside class="editor-sidebar d-flex flex-column min-w-0 min-h-0 p-3" id="editor-sections-sidebar" data-editor-sidebar>
            <div class="editor-file-card surface-panel rounded-3 p-3 flex-shrink-0">
              <div class="d-flex align-items-start gap-3">
                <span class="editor-file-card-icon place-items-center d-grid flex-shrink-0"><i class="fa-regular fa-file-code"></i></span>
                <div class="min-w-0 flex-grow-1">
                  <strong class="editor-item-title d-block text-truncate fw-semibold" data-current-file>config.yml</strong>
                  <span class="editor-file-card-meta d-block mt-1" data-current-file-meta></span>
                </div>
                {allowManualWorkspaces && <button class="editor-icon-button editor-interactive-surface d-inline-grid flex-shrink-0" type="button" title="Open another file" aria-label="Open another file" data-open-file data-change-file-single hidden><i class="fa-solid fa-arrow-right-arrow-left"></i></button>}
              </div>
            </div>

            <section class="editor-sections-panel min-w-0 min-h-0 flex-grow-1 d-flex flex-column overflow-hidden mt-0 mt-sm-3">
              <div class="editor-eyebrow px-1 mb-2" data-sections-heading>Sections</div>
              <nav class="editor-sections d-grid gap-1 min-w-0 min-h-0" data-editor-sections aria-label="Config sections"></nav>
            </section>
          </aside>
          <div
            class="editor-sidebar-resizer position-relative d-none d-lg-block"
            role="separator"
            tabindex="0"
            aria-label="Resize sections sidebar"
            aria-controls="editor-sections-sidebar"
            aria-orientation="vertical"
            data-sidebar-resizer="sections"
          ></div>
        </div>
        <footer class="site-modal-footer mt-auto flex-shrink-0" data-editor-sidebar-controls hidden></footer>
      </div>

      <button class="editor-navigation-backdrop rounded-0" type="button" aria-label="Close editor navigation" data-editor-navigation-backdrop hidden></button>

      <section class="editor-main d-flex flex-column min-w-0 min-h-0 overflow-auto" data-editor-scroll data-editor-file-content>
        <div class="editor-visual-workspace" data-visual-workspace>
          <div data-editor-warnings hidden></div>
          <div class="editor-tools px-3 px-xl-4 py-1 py-md-2 d-grid gap-2 align-items-center flex-shrink-0" data-editor-tools>
            <div class="editor-search d-flex align-items-center gap-2 mb-0 rounded-3" role="search">
              <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              <label class="visually-hidden" for="editor-setting-search">Search this file</label>
              <span class="editor-search-field position-relative flex-grow-1 min-w-0 overflow-hidden">
                <input class="w-100 min-w-0 p-0 border-0 bg-transparent" id="editor-setting-search" type="search" autocomplete="off" placeholder="Search settings, descriptions, or paths" data-setting-search />
                <span class="editor-search-hint position-absolute top-0 end-0 bottom-0 start-0 d-flex d-sm-none align-items-center overflow-hidden pe-none" aria-hidden="true"><span class="d-block text-nowrap">Search settings, descriptions, or paths</span></span>
              </span>
              <button class="editor-search-clear place-items-center d-grid flex-shrink-0 p-0 border-0 bg-transparent" type="button" aria-label="Clear search" data-clear-search hidden><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="editor-view-actions editor-control-hint d-flex align-items-center justify-content-end gap-2">
              <span class="d-none d-sm-inline" data-view-results>All settings</span>
              <div class="editor-view-overflow editor-more-actions dropdown" data-view-overflow>
                <button class="editor-icon-button editor-interactive-surface d-grid" type="button" title="More view actions" aria-label="More view actions" aria-expanded="false" data-bs-toggle="dropdown" data-bs-auto-close="true">
                  <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end editor-more-actions-menu">
                  <div class="editor-more-actions-label px-2 pt-1 pb-1 fw-bold text-uppercase">Filters</div>
                  <button class="dropdown-item editor-more-actions-item d-grid w-100 border-0 text-start" type="button" aria-pressed="false" data-view-mode="common">
                    <span class="editor-more-actions-icon d-inline-grid flex-shrink-0"><i class="fa-solid fa-star" aria-hidden="true"></i></span>
                    <span class="editor-more-actions-copy d-grid min-w-0"><span class="editor-more-actions-title fw-semibold">Common settings</span><span class="editor-more-actions-help">Show the settings edited most often.</span></span>
                  </button>
                  <button class="dropdown-item editor-more-actions-item d-grid w-100 border-0 text-start" type="button" aria-pressed="false" data-view-mode="changed">
                    <span class="editor-more-actions-icon d-inline-grid flex-shrink-0"><i class="fa-solid fa-pen" aria-hidden="true"></i></span>
                    <span class="editor-more-actions-copy d-grid min-w-0"><span class="editor-more-actions-title fw-semibold">Changed settings</span><span class="editor-more-actions-help">Show values that differ from their defaults.</span></span>
                  </button>
                  <button class="dropdown-item editor-more-actions-item d-grid w-100 border-0 text-start" type="button" aria-pressed="false" data-view-mode="advanced">
                    <span class="editor-more-actions-icon d-inline-grid flex-shrink-0"><i class="fa-solid fa-gears" aria-hidden="true"></i></span>
                    <span class="editor-more-actions-copy d-grid min-w-0"><span class="editor-more-actions-title fw-semibold">Advanced settings</span><span class="editor-more-actions-help">Show advanced and less common settings.</span></span>
                  </button>
                  <button class="dropdown-item editor-more-actions-item d-grid w-100 border-0 text-start" type="button" aria-pressed="true" data-view-mode="all">
                    <span class="editor-more-actions-icon d-inline-grid flex-shrink-0"><i class="fa-solid fa-list" aria-hidden="true"></i></span>
                    <span class="editor-more-actions-copy d-grid min-w-0"><span class="editor-more-actions-title fw-semibold">All settings</span><span class="editor-more-actions-help">Show every setting in this file.</span></span>
                  </button>
                  <div class="editor-more-actions-divider" role="separator"></div>
                  <div class="editor-more-actions-label px-2 pt-1 pb-1 fw-bold text-uppercase">Group display</div>
                  <button class="dropdown-item editor-more-actions-item d-grid w-100 border-0 text-start" type="button" data-collapse-groups>
                    <span class="editor-more-actions-icon d-inline-grid flex-shrink-0"><i class="fa-solid fa-angles-up" aria-hidden="true"></i></span>
                    <span class="editor-more-actions-copy d-grid min-w-0"><span class="editor-more-actions-title fw-semibold">Collapse all groups</span><span class="editor-more-actions-help">Reduce the visible section to its headings.</span></span>
                  </button>
                  <button class="dropdown-item editor-more-actions-item d-grid w-100 border-0 text-start" type="button" data-expand-groups>
                    <span class="editor-more-actions-icon d-inline-grid flex-shrink-0"><i class="fa-solid fa-angles-down" aria-hidden="true"></i></span>
                    <span class="editor-more-actions-copy d-grid min-w-0"><span class="editor-more-actions-title fw-semibold">Expand all groups</span><span class="editor-more-actions-help">Reveal every group in the visible section.</span></span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="editor-mobile-group-sticky" data-editor-mobile-group-sticky aria-hidden="true" inert>
            <div class="editor-mobile-group-sticky-header editor-sticky-group-header d-flex align-items-center gap-2 px-3">
              <details class="editor-mobile-group-details min-w-0 flex-grow-1" data-editor-mobile-group-details>
                <summary class="editor-mobile-group-summary d-flex align-items-center gap-2 min-w-0">
                  <span class="editor-mobile-group-copy d-grid min-w-0 flex-grow-1">
                    <span class="editor-mobile-group-context d-block text-truncate" data-editor-mobile-group-context></span>
                    <span class="d-flex align-items-center gap-2 min-w-0">
                      <strong class="editor-group-title editor-item-title d-block overflow-hidden text-nowrap text-truncate" data-editor-mobile-group-title></strong>
                      <code class="editor-group-key d-block text-truncate" data-editor-mobile-group-key></code>
                    </span>
                  </span>
                  <i class="editor-mobile-group-chevron fa-solid fa-chevron-down flex-shrink-0" aria-hidden="true"></i>
                </summary>
                <div class="editor-mobile-group-ancestors surface-panel rounded-3 p-1" data-editor-mobile-group-ancestors></div>
              </details>
              <button class="editor-group-pin editor-icon-button editor-interactive-surface d-grid flex-shrink-0" type="button" tabindex="-1" data-editor-mobile-group-pin>
