  </dialog>

  <dialog class="editor-dialog editor-dialog--form editor-use-saved-dialog surface-panel site-modal-surface p-0" aria-labelledby="editor-use-saved-title" data-use-saved-dialog>
    <form data-use-saved-form>
      <div class="editor-dialog-header site-modal-header d-flex align-items-start justify-content-between gap-3">
        <div>
          <span class="editor-eyebrow">Link to shared value</span>
          <h2 class="mb-1 mt-1" id="editor-use-saved-title">Link <span data-use-saved-target></span></h2>
          <p class="mb-0">Choose a shared value from earlier in this file. This setting will use that value until you unlink it.</p>
        </div>
        <button class="editor-icon-button editor-interactive-surface site-modal-close d-inline-grid flex-shrink-0 ms-auto" type="button" data-close-use-saved aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="site-modal-body">
        <div class="form-floating editor-floating">
          <select class="form-select editor-input editor-input--code" id="editor-use-saved-name" data-use-saved-name required></select>
          <label for="editor-use-saved-name">Shared value</label>
        </div>
        <p class="editor-dialog-hint mt-3 mb-0"><i class="fa-solid fa-circle-info me-2"></i>Only compatible values defined earlier in the file are shown.</p>
      </div>
      <div class="editor-dialog-footer site-modal-footer d-flex justify-content-end gap-2">
        <button class="btn btn-site-secondary btn-site-sm" type="button" data-close-use-saved>Cancel</button>
        <button class="btn btn-site btn-site-primary btn-site-sm fw-bold" type="submit"><i class="fa-solid fa-link me-2"></i>Link setting</button>
      </div>
    </form>
  </dialog>

  <dialog class="editor-dialog editor-dialog--form editor-annotation-dialog surface-panel site-modal-surface p-0" aria-labelledby="editor-annotation-title" data-annotation-dialog>
    <form data-annotation-form>
      <div class="editor-dialog-header site-modal-header d-flex align-items-start justify-content-between gap-3">
        <div>
          <span class="editor-eyebrow">Inheritance rules</span>
          <h2 class="mb-1 mt-1" id="editor-annotation-title">Control how <span data-annotation-target></span> is inherited</h2>
          <p class="mb-0">These rules affect parent-template imports and GUI synchronization. They do not link settings together.</p>
        </div>
        <button class="editor-icon-button editor-interactive-surface site-modal-close d-inline-grid flex-shrink-0 ms-auto" type="button" data-close-annotation aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="site-modal-body d-grid gap-2">
        <label class="editor-policy-option rounded-3 p-3 d-flex align-items-start gap-3">
          <input class="form-check-input flex-shrink-0" type="checkbox" value="final" data-annotation-policy />
          <span><strong class="d-block">Final</strong><span class="editor-control-hint">A parent config cannot replace this value.</span></span>
        </label>
        <label class="editor-policy-option rounded-3 p-3 d-flex align-items-start gap-3">
          <input class="form-check-input flex-shrink-0" type="checkbox" value="ignore-if-set" data-annotation-policy />
          <span><strong class="d-block">Ignore if set</strong><span class="editor-control-hint">Keep this local value when the imported parent also provides one.</span></span>
        </label>
        <label class="editor-policy-option rounded-3 p-3 d-flex align-items-start gap-3">
          <input class="form-check-input flex-shrink-0" type="checkbox" value="no-sync" data-annotation-policy />
          <span><strong class="d-block">No sync</strong><span class="editor-control-hint">Keep this value unchanged when GUI settings are synchronized.</span></span>
        </label>
      </div>
      <div class="editor-dialog-footer site-modal-footer d-flex justify-content-end gap-2">
        <button class="btn btn-site-secondary btn-site-sm" type="button" data-close-annotation>Cancel</button>
        <button class="btn btn-site btn-site-primary btn-site-sm fw-bold" type="submit"><i class="fa-solid fa-shield-halved me-2"></i>Save rules</button>
      </div>
    </form>
  </dialog>

  <dialog class="editor-dialog editor-dialog--form editor-confirmation-dialog surface-panel site-modal-surface p-0" aria-labelledby="editor-confirmation-title" aria-describedby="editor-confirmation-message" data-editor-confirmation-dialog>
    <form method="dialog" data-editor-confirmation-form>
      <div class="editor-dialog-header site-modal-header d-flex align-items-start gap-3">
        <span class="editor-confirmation-icon d-inline-grid flex-shrink-0" aria-hidden="true"><i class="fa-solid fa-clock-rotate-left"></i></span>
        <div class="min-w-0">
          <span class="editor-eyebrow" data-editor-confirmation-eyebrow>Unsaved local draft</span>
          <h2 class="mb-1 mt-1" id="editor-confirmation-title" data-editor-confirmation-title>Restore unsaved changes?</h2>
        </div>
      </div>
      <div class="site-modal-body">
        <p class="editor-confirmation-message mb-0" id="editor-confirmation-message" data-editor-confirmation-message></p>
      </div>
      <div class="editor-dialog-footer site-modal-footer d-flex flex-wrap justify-content-center justify-content-sm-end gap-2">
        <button class="btn btn-site-secondary btn-site-sm" type="submit" value="cancel" data-editor-confirmation-cancel>Use server version</button>
        <button class="btn btn-site btn-site-primary btn-site-sm fw-bold" type="submit" value="confirm" data-editor-confirmation-confirm><i class="fa-solid fa-clock-rotate-left me-2" aria-hidden="true"></i><span>Restore draft</span></button>
      </div>
    </form>
  </dialog>

  <dialog class="editor-dialog editor-dialog--form surface-panel site-modal-surface p-0" aria-labelledby="editor-session-expired-title" aria-describedby="editor-session-expired-message" data-editor-session-expired-dialog>
    <div class="editor-dialog-header site-modal-header d-flex align-items-center gap-3">
      <h2 class="mb-0" id="editor-session-expired-title">Editing session expired</h2>
      <button class="site-modal-close d-inline-grid flex-shrink-0 ms-auto" type="button" data-close-session-expired aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <div class="site-modal-body">
      <p class="editor-confirmation-message mb-3" id="editor-session-expired-message">Saving configs directly to your server is no longer possible. Your work is still available in this tab. Download it before closing or refreshing!</p>
      <p class="editor-dialog-hint mb-0">Run <code>/k admin editor</code> for a fresh link to the current server files. Use your backup to recover your changes manually. It will not be applied automatically.</p>
    </div>
    <div class="editor-dialog-footer site-modal-footer d-flex flex-column flex-sm-row justify-content-sm-end gap-2">
      <button class="btn btn-site-secondary btn-site-sm" type="button" data-close-session-expired>Keep browsing</button>
      <button class="btn btn-site btn-site-primary btn-site-sm fw-bold" type="button" data-download-recovery autofocus><i class="fa-solid fa-download me-2" aria-hidden="true"></i>Download backup</button>
    </div>
  </dialog>

  <div class="editor-save-overlay position-fixed d-grid" data-editor-save-overlay hidden>
    <div class="editor-save-progress surface-panel rounded-3 p-4 text-center" role="status" aria-live="polite" tabindex="-1" data-editor-save-status>
      <span class="editor-save-spinner d-inline-grid mb-3" aria-hidden="true"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
      <span class="editor-eyebrow d-block">Secure server save</span>
      <h2 class="h4 mb-2 mt-1">Saving configs…</h2>
      <p class="mb-2" data-editor-save-progress>Checking configs…</p>
      <small class="d-block">Keep this tab open. Editing will resume after your Minecraft server confirms the changes.</small>
    </div>
  </div>

  <div class="editor-corner-stack position-fixed d-flex flex-column align-items-end gap-2 p-3">
    <div class="toast-container site-toast-container position-static w-100 p-0 d-flex flex-column align-items-end" data-editor-toast-container></div>
    <button class="editor-gui-preview-launcher btn btn-site d-inline-flex align-items-center gap-2" type="button" aria-controls="editor-gui-inventory-preview" aria-expanded="false" data-gui-preview-launcher hidden>
      <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
      <span>Inventory preview</span>
    </button>
  </div>

  <script>
    import "bootstrap";
    import { initAmbientPointer } from "../assets/scripts/ambient-pointer.js";
    import "../assets/scripts/copy-command.js";
    import "../assets/scripts/config-editor/editor-workspace.js";

    initAmbientPointer();
  </script>
</BaseLayout>
