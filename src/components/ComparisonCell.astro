---
import type { CellValue } from "../data/comparison";

interface Props {
  value: CellValue;
  highlight?: boolean;
  [key: string]: any;
}

const { value, highlight = false, ...rest } = Astro.props;

const textValue = typeof value === "string" ? value : value.label;
const hint = typeof value === "string" ? undefined : value.hint;
const href = typeof value === "string" ? undefined : value.href;
const normalized = textValue.toLowerCase();

const labels: Record<string, string> = {
  yes: "Yes",
  partial: "Partial",
  addon: "Addon",
  no: "No",
  na: "N/A",
  free: "Free",
  premium: "Premium",
};

const isSymbolic = normalized === "yes" || normalized === "no";
const isTextLabel = normalized === "addon" || normalized === "na" || normalized.startsWith("free") || normalized.startsWith("premium");
const ariaLabel = labels[normalized] || textValue;
const cellClass = highlight ? "kingdomsx-column" : "";
---

<td class:list={["comparison-cell", cellClass]} data-value={normalized} {...rest}>
  {normalized === "yes" && (
    <span class="comparison-symbol comparison-symbol--yes" aria-label={ariaLabel} title={ariaLabel}>
      <i class="fa-solid fa-check" aria-hidden="true"></i>
    </span>
  )}
  {normalized === "no" && (
    <span class="comparison-symbol comparison-symbol--no" aria-label={ariaLabel} title={ariaLabel}>
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </span>
  )}
  {normalized === "addon" && (
    <span class="comparison-text-label comparison-text-label--addon d-inline-block fw-bold text-nowrap" aria-label={ariaLabel}>{labels[normalized]}</span>
  )}
  {normalized === "na" && (
    <span class="comparison-text-label comparison-text-label--na d-inline-block fw-bold text-nowrap" aria-label={ariaLabel}>{labels[normalized]}</span>
  )}
  {normalized.startsWith("free") && (
    <span class="comparison-text-label comparison-text-label--free d-inline-block fw-bold text-wrap text-break mw-100" aria-label={ariaLabel}>{textValue}</span>
  )}
  {normalized.startsWith("premium") && (
    <span class="comparison-text-label comparison-text-label--premium d-inline-block fw-bold text-nowrap" aria-label={ariaLabel}>{textValue}</span>
  )}
  {!isSymbolic && !isTextLabel && (
    <span class:list={["comparison-text", "d-inline-block", "text-center", "fw-semibold", normalized === "partial" && "comparison-text--partial"]} aria-label={ariaLabel}>{labels[normalized] || textValue}</span>
  )}
  {hint && (
    <button
      class="feature-hint d-inline-flex align-items-center justify-content-center align-middle flex-shrink-0 p-0 ms-1 border-0 rounded-circle bg-transparent"
      type="button"
      data-bs-toggle="tooltip"
      data-bs-placement="top"
      data-bs-title={hint}
      aria-label={hint}
    >
      <i class="fa-regular fa-circle-question" aria-hidden="true"></i>
    </button>
  )}
  {href && (
    <a
      class="feature-hint d-inline-flex align-items-center justify-content-center align-middle p-0 ms-1 border-0 rounded-circle bg-transparent"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`More about ${textValue} (opens in a new tab)`}
    >
      <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
    </a>
  )}
</td>
