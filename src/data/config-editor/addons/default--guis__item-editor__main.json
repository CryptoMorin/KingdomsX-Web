    {
      "path": [
        "title"
      ],
      "source": "\"{$sep}-=( {$p}Item Editor {$sep})=-\"",
      "comments": [],
      "container": false,
      "emptyMapping": false,
      "complexSequence": false,
      "collectionItems": null
    },
