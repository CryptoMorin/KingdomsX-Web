      "source": "\r\n  back:\r\n    posx: 1\r\n    posy: 1\r\n    material: PLAYER_HEAD\r\n    name: '{$p}Back'\r\n    lore: [ '{$s}Go back to nexus menu.' ]\r\n    skull: \"{$gui-back}\"\r\n  flag:\r\n    posx: 4\r\n    posy: 2\r\n    material: FILLED_MAP\r\n    name: \"{$p}Flag\"\r\n    lore: |\r\n      {$desc}Sets the your kingdom flag\r\n      that may appear on online web maps\r\n      when someone clicks your kingdom\r\n      to see the description.\r\n\r\n      %banner_description%\r\n  banner:\r\n    posx: 6\r\n    posy: 2\r\n    material: WHITE_BANNER\r\n    name: \"{$p}Banner\"\r\n    lore: |\r\n      {$desc}Sets the your kingdom banner\r\n      that may appear as icons inside\r\n      online web maps, also used for\r\n      your main kingdom flag if a flag\r\n      is not set for the other option.\r\n\r\n      %banner_description%\r\n\r\n  blue-stained-glass-pane:\r\n    slots: [ 1, 2, 6, 7, 8, 9, 10, 16, 17, 18, 19, 20, 24, 25, 26 ]\r\n    material: BLUE_STAINED_GLASS_PANE\r\n    name: ''\r\n  orange-stained-glass-pane:\r\n    slots: [ 3, 4, 5, 11, 13, 15, 21, 22, 23 ]\r\n    material: ORANGE_STAINED_GLASS_PANE\r\n    name: ''\r\n",
