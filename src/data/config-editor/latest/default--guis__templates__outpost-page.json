    {
      "path": [
        "base"
      ],
      "source": "&base\r\n  name: \"&5%item_name%\"\r\n  lore: |\r\n    {$p}{? !buy_allowed ? \"&m\"}Buy{$colon} {$s}%fancy@buy% {$sep}({$sp}Left-click{$sep}){? buy_max_items != -1 ? \" {$sep}({$sp}Max{$colon} &5%buy_max_items%{$sep})\" }\r\n    {$p}Sell{$colon} {$s}%fancy@sell% {$sep}({$sp}Right-click{$sep})\r\n    {? !buy_allowed ? \"\r\n    {$e}You cannot buy this item\r\n    {$e}until {$es}%time@buy_cooldown%\"}\r\n\r\n",
      "comments": [
        "Used in imported configs."
      ],
      "container": true,
      "emptyMapping": false,
