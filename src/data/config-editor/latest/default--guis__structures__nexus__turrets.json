    {
      "path": [
        "options"
      ],
      "source": "\r\n  arrow:\r\n    name: \"{$p}Arrow\"\r\n    material: ARROW\r\n    sound: ENTITY_ARROW_SHOOT\r\n    lore: |\r\n      {$s}A simple turret that fires plain\r\n      arrows at enemies at a moderate rate.\r\n\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 2\r\n    posy: 2\r\n  flame:\r\n    name: \"&3Flame\"\r\n    material: SPECTRAL_ARROW\r\n    sound: ITEM_FLINTANDSTEEL_USE\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}Fast-firing turret that sets\r\n      targets ablaze.\r\n\r\n      {$chk-kingdom-lvl-II}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 3\r\n    posy: 2\r\n  healing:\r\n    name: \"&dHealing\"\r\n    material: TIPPED_ARROW\r\n    sound: ENTITY_ZOMBIE_VILLAGER_CURE\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}Heals nearby members and allies.\r\n\r\n      {$chk-kingdom-lvl-II}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 4\r\n    posy: 2\r\n  psionic:\r\n    name: \"&aPsionic\"\r\n    material: TRIPWIRE_HOOK\r\n    sound: ENTITY_PLAYER_HURT_ON_FIRE\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}Effects the enemies nearby.\r\n      Higher levels add more effects.\r\n      But never deals killing damage.\r\n\r\n      {$chk-kingdom-lvl-III}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 5\r\n    posy: 2\r\n  hellfire:\r\n    name: \"&cHellfire\"\r\n    material: FIRE_CHARGE\r\n    sound: ITEM_FIRECHARGE_USE\r\n    lore: |\r\n      {$s}Powerful turret that fires quickly\r\n      with high damage.\r\n\r\n      {$chk-kingdom-lvl-III}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 6\r\n    posy: 2\r\n  soldier:\r\n    name: \"&5Soldier\"\r\n    sound: ENTITY_ZOMBIE_VILLAGER_CONVERTED\r\n    material: ZOMBIE_HEAD\r\n    lore: |\r\n      {$s}Spawns guards to kill the\r\n      target player.\r\n\r\n      {$chk-kingdom-lvl-IV}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 7\r\n    posy: 2\r\n  heatbeam:\r\n    name: \"&3Heatbeam\"\r\n    sound: ENTITY_GUARDIAN_ATTACK\r\n    material: MAGMA_CREAM\r\n    lore: |\r\n      {$s}Targets singular targets and deals\r\n      a high amount of damage.\r\n\r\n      {$chk-kingdom-lvl-IV}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 8\r\n    posy: 2\r\n  inferno:\r\n    name: \"&4Inferno\"\r\n    material: END_CRYSTAL\r\n    sound: ENTITY_ELDER_GUARDIAN_CURSE\r\n    lore: |\r\n      {$s}Similar to Heatbeams.\r\n\r\n      {$chk-kingdom-lvl-V}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 5\r\n    posy: 1\r\n  spring:\r\n    name: \"{$sep}Spring\"\r\n    material: OAK_PRESSURE_PLATE\r\n    sound: BLOCK_STONE_PRESSURE_PLATE_CLICK_ON\r\n    lore: |\r\n      {$s}A mine that\r\n      throws the player into\r\n      the air when stepped on.\r\n\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 5\r\n    posy: 3\r\n  explosive-mine:\r\n    name: \"{$sep}Explosive Mine\"\r\n    material: HEAVY_WEIGHTED_PRESSURE_PLATE\r\n    sound: BLOCK_STONE_PRESSURE_PLATE_CLICK_ON\r\n    lore: |\r\n      {$s}A mine that\r\n      explodes when stepped on.\r\n\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 6\r\n    posy: 3\r\n  chemical-mine:\r\n    name: \"&8Chemical Mine\"\r\n    material: LIGHT_WEIGHTED_PRESSURE_PLATE\r\n    sound: BLOCK_METAL_PRESSURE_PLATE_CLICK_ON\r\n    lore: |\r\n      {$s}A mine that gives\r\n      the player debuffs when stepped on.\r\n\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 4\r\n    posy: 3\r\n  back:\r\n    name: \"{$p}Back\"\r\n    material: PLAYER_HEAD\r\n    skull: \"{$gui-back}\"\r\n    lore: |\r\n      {$s}Go back to nexus menu.\r\n    posx: 5\r\n    posy: 4\r\n  Cyan-Glass:\r\n    name: \"\"\r\n    material: CYAN_STAINED_GLASS_PANE\r\n    slots: [ 1, 7, 9, 17, 18, 26, 28, 34 ]\r\n  Light-Blue-Glass:\r\n    name: \"\"\r\n    material: LIGHT_BLUE_STAINED_GLASS_PANE\r\n    slots: [ 0, 8, 27, 35 ]\r\n",
