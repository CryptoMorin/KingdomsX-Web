    {
      "path": [
        "options"
      ],
      "source": "\r\n  back:\r\n    slot: 0\r\n    material: PLAYER_HEAD\r\n    skull: \"{$gui-back}\"\r\n    name: '&cBack'\r\n  play-boss-music:\r\n    slot: 2\r\n    material: MUSIC_DISC_CAT\r\n    lore: |\r\n      {$sep}Plays the ender dragon theme\r\n      while this bossbar is active for\r\n      the player. This doesn't work\r\n      reliably for all servers.\r\n    enabled:\r\n      name: '{$enabled} Music'\r\n      condition: enabled\r\n      glow: true\r\n    else:\r\n      name: '{$disabled} Music'\r\n  darken-sky:\r\n    slot: 3\r\n    material: CLOCK\r\n    lore: |\r\n      {$sep}It's similar to blindness\r\n      potion effect.\r\n    enabled:\r\n      name: '{$enabled} Darken Sky'\r\n      condition: enabled\r\n      glow: true\r\n    else:\r\n      name: '{$disabled} Darken Sky'\r\n  create-fog:\r\n    slot: 4\r\n    material: COBWEB\r\n    lore: |\r\n      {$sep}Mostly restricts the player's\r\n      sight and view distance.\r\n    enabled:\r\n      name: '{$enabled} Fog'\r\n      condition: enabled\r\n      glow: true\r\n    else:\r\n      name: '{$disabled} Fog'",
