        "options"
      ],
      "source": "\r\n  name:\r\n    name: \"&5Name{$colon} {$p}%rank_name%\"\r\n    material: DIAMOND\r\n    lore:\r\n      - \"{$s}The name of this rank.\"\r\n      - \"Can contain any character but must be\"\r\n      - \"20 characters max.\"\r\n      - \"It can also contain color codes.\"\r\n    posx: 1\r\n    posy: 1\r\n  material:\r\n    name: \"&eMaterial{$colon} {$p}%rank_material%\"\r\n    material: GOLD_INGOT\r\n    lore:\r\n      - \"{$s}The material used to display\"\r\n      - \"this rank in the ranks GUI.\"\r\n      - \"You should use the latest material names\"\r\n      - \"even if the server is running on old versions.\"\r\n    posx: 2\r\n    posy: 1\r\n  symbol:\r\n    name: \"&dSymbol{$colon} {$p}%rank_symbol%\"\r\n    material: IRON_INGOT\r\n    lore:\r\n      - \"{$s}Symbol for this rank.\"\r\n      - \"It can only be 5 characters.\"\r\n      - \"Also supports colors.\"\r\n    posx: 3\r\n    posy: 1\r\n  color:\r\n    name: \"%rank_color%Color\"\r\n    material: COAL\r\n    lore:\r\n      - \"{$s}The chat color for this rank.\"\r\n      - \"It can only be 5 characters.\"\r\n    posx: 4\r\n    posy: 1\r\n\r\n  back:\r\n    name: \"{$p}Back\"\r\n    material: PLAYER_HEAD\r\n    skull: \"{$gui-back}\"\r\n    lore:\r\n      - \"{$s}Go back to nexus menu.\"\r\n    posx: 9\r\n    posy: 1",
