      "source": "\r\n  confirm:\r\n    material: GREEN_WOOL\r\n    sound: AMBIENT_CAVE\r\n    slot: 1\r\n    name: \"&4Confirm\"\r\n    lore:\r\n      - \"{$s}Are you sure you want to reset all\"\r\n      - \"the custom ranks made in your kingdom?\"\r\n      - \"Doing so will result in &lall {$s}your\"\r\n      - \"members being demoted to member rank.\"\r\n      - \"\"\r\n      - \"This will reset the rank settings to their\"\r\n      - \"original state defined by the server.\"\r\n      - \"This includes deleting newly created ranks\"\r\n      - \"and adding back the default settings for each rank.\"\r\n  cancel:\r\n    material: RED_WOOL\r\n    sound: BLOCK_NOTE_BLOCK_BASS, 1, 1\r\n    slot: 3\r\n    name: \"&cCancel\"\r\n    lore: [ \"{$s}Cancel confirmation.\" ]",
