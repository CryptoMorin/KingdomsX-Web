      {
        "key": "accuracy",
        "type": {
          "kind": "integer",
          "minimum": 1,
          "description": "Ticks between turret target-data refreshes.",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default",
              "editor-overlay"
            ]
          },
          "optional": true
