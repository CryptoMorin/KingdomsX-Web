                        "sources": [
                          "editor-overlay",
                          "jar-default"
                        ]
                      },
                      "optional": true
                    }
                  },
                  {
                    "key": "default-save-format",
                    "type": {
                      "kind": "nullable",
                      "value": {
                        "kind": "enum",
                        "values": [
                          "MCEDIT_SCHEMATIC",
                          "SPONGE_SCHEMATIC",
                          "SPONGE_V1_SCHEMATIC",
                          "SPONGE_V2_SCHEMATIC",
                          "SPONGE_V3_SCHEMATIC",
                          "FAST_V3",
                          "FAST_V2",
                          "PNG",
                          "MINECRAFT_STRUCTURE",
