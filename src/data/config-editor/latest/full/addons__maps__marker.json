  "schema": {
    "kind": "object",
    "fields": [
      {
        "key": "persistent-data",
        "type": {
          "kind": "boolean",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "WARNING: It's not recommneded to use this option as it might not remove some outdated markers in the future. If the marker data should be persistent. If enabled, all the land markers and icons will stay even after server restarts. This is useful when your server has a lot of claimed lands, or you want to avoid lag without using the auto update interval option. The data will be internally stored in Dynmap. Needs a restart to update. Note that if you change it from true to false, the old data will still stay. It's not recommended to use this, as it may no longer work with future updates. This currently only works with Dynmap.",
          "optional": true
        }
      },
      {
        "key": "label",
        "type": {
          "kind": "string",
          "typeName": "str",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "The name shown on markers tab of map plugins on the web. Unfortunately none of the maps provide any translation capabilities.",
          "optional": true
        }
      },
      {
        "key": "priority",
        "type": {
          "kind": "integer",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "Priority of the marker visibility in the map. (See z-index for more info) Needs a restart to update.",
          "optional": true
        }
      },
      {
        "key": "z-index",
        "type": {
          "kind": "integer",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "The distinction between z-index and layer priority isn't exactly defined for all map plugins, but for some of them layer priority will completely hide overlapping layers with lower priority, but it'll move the layer behind the other layer with higher z-index. BlueMap doesn't have support for priority or z-index, but has support for \"sorting\" below.",
          "optional": true
        }
      },
      {
        "key": "special-flag",
        "type": {
          "kind": "boolean",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "For Dynmap this option will boost marker resolutions. For BlueMap, this option controls \"depth-test\" If the depth-test is disabled, you can see the marker fully through all objects on the map. If it is enabled, you'll only see the marker when it is not behind anything. This needs a restart to update.",
          "optional": true
        }
      },
      {
        "key": "hide-by-default",
        "type": {
          "kind": "boolean",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "If the kingdoms marker should be disabled by default. Needs a restart to update.",
          "optional": true
        }
      },
      {
        "key": "zoom",
        "type": {
          "kind": "object",
          "fields": [
            {
              "key": "max",
              "type": {
                "kind": "integer",
                "description": "Maximum visible zoom percentage. Use -1 for no maximum.",
                "optional": true,
                "minimum": -1,
                "maximum": 100,
                "capability": {
                  "sources": [
                    "editor-overlay",
                    "jar-schema",
                    "jar-default"
                  ]
                }
              }
            },
            {
              "key": "min",
              "type": {
                "kind": "integer",
                "description": "Minimum visible zoom percentage. Use -1 for no minimum.",
                "optional": true,
                "minimum": -1,
                "maximum": 100,
                "capability": {
                  "sources": [
                    "editor-overlay",
                    "jar-schema",
                    "jar-default"
                  ]
                }
              }
            }
          ],
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "The zoom level range which the markers are visible at. set to -1 for no max/min limit. It starts from 0% to 100% All these values are normalized correctly according to the specific map system that your server is using. Only Dynmap and BlueMap support this feature. And even then, BlueMaps motion system in general is extremely unstable unlike Dynmap, certain values might act weird or lose change opacity depending on how you're looking at the map. Because it has a gradual opacity fading effect unlike Dynmap that immediatelly hides or shows the markers. * LiveAtlas is known to break zoom levels for Dynmap. Either adjust the value manually or diasble it.",
          "optional": true
        }
      },
