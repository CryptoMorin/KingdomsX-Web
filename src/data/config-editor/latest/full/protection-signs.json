  "schema": {
    "kind": "object",
    "fields": [
      {
        "key": "enabled",
        "type": {
          "kind": "boolean",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "Completely disable this system. Requires a restart to work. Note that the data and the placed signs will still remain, but they will not work until this is turned back on. If you turn this back on, the previous data on the old protected blocks will continue to work even if that block or its sign no longer exist.",
          "optional": true
        }
      },
      {
        "key": "protect-unclaimed",
        "type": {
          "kind": "boolean",
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "If set to false, the protection data will remain and if someone wants to access the chest they must break the sign or the chest. This is useful when unclaiming by mistake.",
          "optional": true
        }
      },
      {
        "key": "protections",
        "type": {
          "kind": "object",
          "fields": [
            {
              "key": "explosion",
              "type": {
                "kind": "boolean",
                "capability": {
                  "sources": [
                    "jar-schema",
                    "jar-default"
                  ]
                },
                "description": "This will protect blocks and the sign regardless of the anti-explosion misc upgrade.",
                "optional": true
              }
            },
            {
              "key": "piston",
              "type": {
                "kind": "boolean",
                "capability": {
                  "sources": [
                    "jar-schema",
                    "jar-default"
                  ]
                },
                "optional": true
              }
            },
            {
              "key": "container-transfers",
              "type": {
                "kind": "object",
                "fields": [
                  {
                    "key": "enabled",
                    "type": {
                      "kind": "boolean",
                      "capability": {
                        "sources": [
                          "jar-schema",
                          "jar-default"
                        ]
                      },
                      "description": "Should this protection be enabled at all?",
                      "optional": true
                    }
                  },
                  {
                    "key": "disallow-all",
                    "type": {
                      "kind": "boolean",
                      "capability": {
                        "sources": [
                          "jar-schema",
                          "jar-default"
                        ]
                      },
                      "description": "You might want to disable this option completely if your server has a lot of hoppers. This will significantly help. By disabling this option no item transfers will be accepted even if the container transferring the items belongs to the owner.",
                      "optional": true
                    }
                  },
                  {
                    "key": "disallow-cross-origin-container-transfers",
                    "type": {
                      "kind": "boolean",
                      "capability": {
                        "sources": [
                          "jar-schema",
                          "jar-default"
                        ]
                      },
                      "description": "* If set to false, when both containers are protected and the owners of both containers gave permission to each other to access their containers, then items will be transferred normally. * If set to true, only when the two containers are owned by the same player items will be transferred normally.",
                      "optional": true
                    }
                  }
                ],
                "capability": {
                  "sources": [
                    "jar-schema",
                    "jar-default"
                  ]
                },
                "description": "This option prevents item transfers between containers, e.g. chest -> hopper or vice versa. * All the options listed under this entry are cached for performance reasons. Meaning that a server restart is required for changes to take effect.",
                "optional": true
              }
            }
          ],
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "Protect the chest and sign from these environmental actions.",
          "optional": true
        }
      },
      {
        "key": "denied-sound",
        "type": {
          "kind": "suggestion",
          "typeName": "Sound",
          "allowCustom": true,
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "Sound played when someone tries to break/access the chest or sign.",
          "optional": true
        }
      },
