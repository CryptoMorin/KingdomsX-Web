              "key": "max-attempts",
              "type": {
                "kind": "integer",
                "capability": {
                  "sources": [
                    "jar-schema",
                    "jar-default"
                  ]
                },
                "description": "How many times can players get the password wrong before they're put in a cooldown? Set to 0 to disable.",
                "optional": true
              }
            },
            {
              "key": "max-attempts-cooldown",
              "type": {
                "kind": "duration",
                "typeName": "Period",
                "capability": {
                  "sources": [
                    "jar-schema",
                    "jar-default"
                  ]
                },
                "description": "For how long are players disallowed to retry entering the password again? This cooldown is not persistent between restarts. This option requires a restart to be applied.",
                "optional": true
              }
            },
            {
              "key": "remove-keyword",
              "type": {
                "kind": "string",
                "typeName": "str",
                "capability": {
                  "sources": [
                    "jar-schema"
                  ]
                },
                "optional": true
              }
            },
            {
              "key": "cookies",
              "type": {
                "kind": "duration",
                "typeName": "Period",
                "capability": {
                  "sources": [
                    "jar-schema",
                    "jar-default"
                  ]
                },
                "description": "The amount of time that the sign remembers who knows the password, so they can access the container without entering the password again. This time resets when the player opens the container. Requires a restart to work.",
                "optional": true
              }
            }
          ],
          "capability": {
            "sources": [
              "jar-schema",
              "jar-default"
            ]
          },
          "description": "This feature is only useful for containers (chests, furnaces and etc) and not any other blocks.",
          "optional": true
        }
