      ],
      "source": "\r\n  shield-6hr:\r\n    name: \"{$p}6 Hours Shield\"\r\n    lore: \"{$s}Cost{$colon} {$p}%cost%\"\r\n    material: SHIELD\r\n    cost: 1000\r\n    time: 6hr\r\n    flags: [ ALL ]\r\n    patterns:\r\n      BASE: BLACK\r\n    posx: 2\r\n    posy: 2\r\n  shield-12hr:\r\n    name: \"{$p}12 Hours Shield\"\r\n    lore: \"{$s}Cost{$colon} {$p}%cost%\"\r\n    material: SHIELD\r\n    flags: [ ALL ]\r\n    cost: 1900\r\n    time: 12hr\r\n    patterns:\r\n      BASE: BLACK\r\n      BORDER: RED\r\n    posx: 3\r\n    posy: 2\r\n  shield-1day:\r\n    name: \"{$p}1 Day Shield\"\r\n    lore: \"{$s}Cost{$colon} {$p}%cost%\"\r\n    material: SHIELD\r\n    cost: 4500\r\n    time: 1day\r\n    flags: [ ALL ]\r\n    patterns:\r\n      BASE: BLACK\r\n      BORDER: RED\r\n      CIRCULE_MIDDLE: RED\r\n    posx: 4\r\n    posy: 2\r\n  shield-1week:\r\n    name: \"{$p}1 Week Shield\"\r\n    lore: \"{$s}Cost{$colon} {$p}%cost%\"\r\n    material: SHIELD\r\n    flags: [ ALL ]\r\n    cost: 50000\r\n    time: 7 days\r\n    patterns:\r\n      BASE: BLACK\r\n      BORDER: RED\r\n      CROSS: RED\r\n    posx: 5\r\n    posy: 2\r\n  shield-1month:\r\n    name: \"{$p}1 Month Shield\"\r\n    lore: \"{$s}Cost{$colon} {$p}%cost%\"\r\n    material: SHIELD\r\n    flags: [ ALL ]\r\n    cost: 100000\r\n    time: 30days\r\n    patterns:\r\n      BASE: BLACK\r\n      BORDER: RED\r\n      MOJANG: RED\r\n    posx: 6\r\n    posy: 2\r\n  refund:\r\n    name: '&5Refund'\r\n    can-refund:\r\n      condition: 'refund != 0'\r\n      lore: |\r\n        {$desc}Deactivates all your shield\r\n        but will refund resource points back.\r\n\r\n        {$p}Shield{$colon} {$s}%time@kingdoms_shield_time_left%\r\n        {$p}Refund{$colon} {$s}%fancy@refund%\r\n    else:\r\n      lore: |\r\n        {$desc}You don't have a shield to refund.\r\n    material: PAPER\r\n    posx: 8\r\n    posy: 2\r\n\r\n  red-stained-glass-pane:\r\n    slots: [ 0, 2, 4, 6, 8, 18, 20, 22, 24, 26 ]\r\n    material: RED_STAINED_GLASS_PANE\r\n    name: ''\r\n  black-stained-glass-pane:\r\n    slots: [ 1, 3, 5, 7, 9, 15, 17, 19, 21, 23, 25 ]\r\n    material: BLACK_STAINED_GLASS_PANE\r\n    name: ''\r\n",
