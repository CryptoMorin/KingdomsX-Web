    {
      "path": [
        "options"
      ],
      "source": "\r\n  powercell:\r\n    name: \"&4Powercell\"\r\n    material: MUSIC_DISC_CHIRP\r\n    sound: BLOCK_REDSTONE_TORCH_BURNOUT\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}Lands surrounded by a powercell cannot\r\n      be invaded until the powercell\r\n      land is invaded first.\r\n      The protection radius is {$p}3x3 {$s}for level 1\r\n      and {$p}5x5 {$s}for level 2.\r\n\r\n      {$chk-kingdom-lvl-II}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n      {? kingdoms_kingdom_is_pacifist ? \"{$note} {$desc}Your kingdom is a pacifist kingdom\r\n      {$desc}and this structure will have no use for your kingdom.\"}\r\n    posx: 3\r\n    posy: 2\r\n  extractor:\r\n    name: \"&aExtractor\"\r\n    material: MUSIC_DISC_CAT\r\n    sound: BLOCK_ANVIL_LAND\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}Extractors produce resource points.\r\n      {$s}You can collect the resource points\r\n      at any time.\r\n\r\n      {$chk-kingdom-lvl-III}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 4\r\n    posy: 2\r\n  outpost:\r\n    name: \"&eOutpost\"\r\n    material: MUSIC_DISC_13\r\n    sound: ENTITY_EXPERIENCE_ORB_PICKUP, 1.5\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}The global stock market\r\n      of kingdoms. Buy and sell\r\n      various items that affects\r\n      the prices of these items globally\r\n      across all outposts.\r\n      This structure also gives you the\r\n      ability to open your nexus remotely.\r\n\r\n      {$chk-kingdom-lvl-II}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 5\r\n    posy: 2\r\n  warppad:\r\n    name: \"&cWarp Pad\"\r\n    material: MUSIC_DISC_BLOCKS\r\n    sound: ENTITY_ENDERMAN_TELEPORT\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}Warp pads can be used to teleport\r\n      from a structure to another.\r\n\r\n      {$chk-kingdom-lvl-IV}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 6\r\n    posy: 2\r\n  regulator:\r\n    name: \"&3Regulator\"\r\n    material: MUSIC_DISC_WARD\r\n    sound: ENTITY_VILLAGER_AMBIENT\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}Manages player attributes such as building,\r\n      turret ceasefire, etc.\r\n      Controls mob/animal spawning,\r\n      turrets (such as auto-refilling ammo) and explosions.\r\n\r\n      {$chk-kingdom-lvl-IV}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n    posx: 7\r\n    posy: 2\r\n  siege-cannon:\r\n    name: \"&3Siege Cannon\"\r\n    material: MUSIC_DISC_STRAD\r\n    sound: ENTITY_VILLAGER_AMBIENT\r\n    flags: [ ALL ]\r\n    lore: |\r\n      {$s}Cannon used to break a kingdom's\r\n      shield.\r\n\r\n      {$chk-kingdom-lvl-III}\r\n      {$p}Cost{$colon} {$s}%fancy@cost%\r\n      {? kingdoms_kingdom_is_pacifist ? \"{$note} {$desc}Your kingdom is a pacifist kingdom\r\n      {$desc}and this structure will have no use for your kingdom.\"}\r\n    posx: 5\r\n    posy: 1\r\n  back:\r\n    name: \"{$p}Back\"\r\n    material: PLAYER_HEAD\r\n    # https://minecraft-heads.com/custom-heads/alphabet/10299-gray-backward\r\n    skull: \"{$gui-back}\"\r\n    lore: |\r\n      {$s}Go back to nexus menu.\r\n    posx: 5\r\n    posy: 3\r\n  cyan-glass:\r\n    name: \"\"\r\n    material: CYAN_STAINED_GLASS_PANE\r\n    slots: [ 1, 7, 9, 17, 19, 25 ]\r\n  light-blue-glass:\r\n    name: \"\"\r\n    material: LIGHT_BLUE_STAINED_GLASS_PANE\r\n    slots: [ 0, 8, 18, 26 ]\r\n",
      "comments": [
        "Apparently HIDE_POTION_EFFECTS item flag will",
        "remove the disc's name from the lore..."
      ],
      "container": true,
      "emptyMapping": false,
      "complexSequence": false,
      "collectionItems": null
    },
