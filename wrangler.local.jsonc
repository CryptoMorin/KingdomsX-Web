{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kingdomsx-web-local",
  "account_id": "97b60c4ab41073fb11d7cb63e7bfa3c7",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/build/*"
    ]
  },
  "observability": {
    "enabled": false
  }
}
